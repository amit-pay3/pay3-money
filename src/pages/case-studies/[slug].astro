---
import fs from 'node:fs';
import path from 'node:path';

export function getStaticPaths() {
  const dir = path.join(process.cwd(), 'src', 'content', 'case-studies');
  const files = fs.readdirSync(dir).filter(f => f.endsWith('.json'));
  return files.map(file => {
    const data = JSON.parse(fs.readFileSync(path.join(dir, file), 'utf-8'));
    const slug = data.slug || file.replace('.json', '');
    data.slug = slug;
    return { params: { slug }, props: { data } };
  });
}

const { data } = Astro.props;
const meta = data.meta || {};
const pageTitle = meta.title || `Pay3 - ${data.title}`;
const description = meta.description || data.highlight;
const ogImage = meta.ogImage || `https://pay3.money${data.thumbnail}`;
const ogUrl = `https://pay3.money/case-studies/${Astro.params.slug}/`;

// Read all case studies for "related" section
const relatedDir = path.join(process.cwd(), 'src', 'content', 'case-studies');
const allStudies = fs.readdirSync(relatedDir)
  .filter(f => f.endsWith('.json'))
  .map(f => {
    const d = JSON.parse(fs.readFileSync(path.join(relatedDir, f), 'utf-8'));
    d.slug = d.slug || f.replace('.json', '');
    return d;
  })
  .filter(d => d.slug !== Astro.params.slug)
  .slice(0, 3);
---
<!DOCTYPE html>
<html lang="en">
<head>
  <title>{pageTitle}</title>
  <link rel="icon" href="/images/logo/pay3_logo.svg" type="image/icon type" />
  <meta charset="UTF-8">
  <meta name="description" content={description} />
  <meta name="viewport" content="initial-scale=1, width=device-width" />
  <link rel="stylesheet" href="/styles/global.css" />
  <link rel="stylesheet" href="/styles/main4.css" />
  <link rel="stylesheet" href="/styles/case-studies.css" />
  <meta property='og:title' content={data.title} />
  <meta property='og:image' content={ogImage} />
  <meta property='og:description' content={description} />
  <meta property='og:url' content={ogUrl} />
  <meta property='og:type' content='article' />
  <meta name='twitter:card' content='summary_large_image' />
  <meta name='twitter:title' content={data.title} />
  <meta name='twitter:description' content={description} />
  <meta name='twitter:image' content={ogImage} />
  <link rel='canonical' href={ogUrl} />
  <script is:inline src="/js/tailwindcss-3.4.3.js"></script>
  <link rel="stylesheet"
    href="https://api.fontshare.com/v2/css?f[]=clash-display@200,400,700,500,600,300&f[]=clash-grotesk@200,700,400,600,300,500&display=swap" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap" />
  <script is:inline>
    tailwind.config = {
      theme: {
        extend: {
          colors: { primary: "#3867DB", secondary: "#0B237F" },
        },
        fontFamily: {
          clashdisplay: ["Clash Display", "sans-serif"],
          grotesk: ["Clash Grotesk", "sans-serif"],
          poppins: ["Poppins", "sans-serif"],
        },
      },
    };
  </script>
</head>
<body class="font-poppins">
  <!-- Header -->
  <header class="layout header md:pl-[20px] lg:pl-[80px] py-6 justify-between items-center flex sticky top-0 z-50 bg-white">
    <a href="/"><img src="/images/logo/pay3-logo.svg" alt="Pay3" class="w-[110px] lg:w-[140px]" /></a>
    <ul class="header-ul hidden md:flex md:gap-5 lg:gap-8 xl:gap-10 lg:mr-[100px]">
      <li class="cursor-pointer"><a href="/?scrollTo=landingLayoutContainer">Solutions</a><span></span></li>
      <li class="cursor-pointer"><a href="/?scrollTo=sectionFeatContainer">Features</a><span></span></li>
      <li class="cursor-pointer"><a href="/?scrollTo=section4Container">About</a><span></span></li>
      <li class="cursor-pointer"><a href="/?scrollTo=faqContainer">FAQ</a><span></span></li>
      <li class="cursor-pointer"><a href="https://docs.pay3.money" target="_blank">Docs</a><span></span></li>
      <li class="cursor-pointer font-medium text-primary"><a href="/case-studies/">Case Studies</a><span></span></li>
      <li class="blog cursor-pointer"><a href="https://medium.com/@pay3" target="_blank">Blog</a><span></span></li>
      <li class="cursor-pointer"><a href="/contact-us/">Contact Us</a><span></span></li>
    </ul>
    <nav class="menu--right" role="navigation">
      <div class="menuToggle">
        <input type="checkbox" id="checkbox" />
        <span></span><span></span><span></span>
        <ul class="menuItem">
          <li><a href="/?scrollTo=landingLayoutContainer">Solutions</a></li>
          <li><a href="/?scrollTo=sectionFeatContainer">Features</a></li>
          <li><a href="/?scrollTo=section4Container">About</a></li>
          <li><a href="/?scrollTo=faqContainer">FAQ</a></li>
          <li><a href="https://docs.pay3.money" target="_blank">Docs</a></li>
          <li><a href="/case-studies/">Case Studies</a></li>
          <li><a href="https://medium.com/@pay3/" target="_blank">Blog</a></li>
          <li><a href="/contact-us/">Contact Us</a></li>
        </ul>
      </div>
    </nav>
  </header>

  <!-- Back link -->
  <div class="max-w-[900px] m-auto px-5 pt-8 pb-2">
    <a href="/case-studies/" class="inline-flex items-center gap-1.5 text-sm font-grotesk text-gray-500 hover:text-primary transition-colors">
      <span class="text-lg">&larr;</span> Back to Case Studies
    </a>
  </div>

  <!-- Hero -->
  <div class="bg-gradient-to-r from-secondary to-primary text-white">
    <div class="max-w-[900px] m-auto px-5 py-12 md:py-20">
      <div class="flex flex-wrap gap-2 mb-4">
        <span class="bg-white/20 text-white text-xs md:text-sm font-medium px-3 py-1 rounded-full">{data.geography}</span>
        <span class="bg-white/20 text-white text-xs md:text-sm font-medium px-3 py-1 rounded-full">{data.industry}</span>
      </div>
      <h1 class="font-clashdisplay text-[26px] md:text-[38px] lg:text-[44px] leading-[1.15] mb-4">{data.title}</h1>
      <p class="font-grotesk text-[16px] md:text-[20px] opacity-90 max-w-[700px]">{data.highlight}</p>
    </div>
  </div>

  <!-- Content -->
  <div class="max-w-[900px] m-auto px-5 py-12 md:py-16">
    {data.customerProfile && (
      <div class="mb-12">
        <h2 class="font-clashdisplay text-[20px] md:text-[26px] font-medium text-gray-900 mb-4">Customer Profile</h2>
        <p class="font-grotesk text-[15px] md:text-[17px] text-gray-600 leading-relaxed">{data.customerProfile}</p>
      </div>
    )}

    <div class="mb-12">
      <h2 class="font-clashdisplay text-[20px] md:text-[26px] font-medium text-gray-900 mb-4">Business Challenge</h2>
      <p class="font-grotesk text-[15px] md:text-[17px] text-gray-600 leading-relaxed">{data.challenge}</p>
    </div>

    {(data.solution || data.solutionImage) && (
      <div class="mb-12">
        <h2 class="font-clashdisplay text-[20px] md:text-[26px] font-medium text-gray-900 mb-4">Pay3 Solutions</h2>
        {data.solution && <p class="font-grotesk text-[15px] md:text-[17px] text-gray-600 leading-relaxed">{data.solution}</p>}
        {data.solutionImage && <img src={data.solutionImage} alt="Pay3 Solutions" class="w-full rounded-xl mt-6" loading="lazy" />}
      </div>
    )}

    <div class="mb-12 bg-gray-50 rounded-2xl p-6 md:p-10">
      <h2 class="font-clashdisplay text-[20px] md:text-[26px] font-medium text-gray-900 mb-4">Business Impact</h2>
      <div class="font-grotesk text-[15px] md:text-[17px] text-gray-600 leading-relaxed cs-results" set:html={data.businessImpact} />
    </div>

    {(data.implementationHighlights || data.implementationImage) && (
      <div class="mb-12">
        <h2 class="font-clashdisplay text-[20px] md:text-[26px] font-medium text-gray-900 mb-4">Implementation Highlights</h2>
        {data.implementationHighlights && <p class="font-grotesk text-[15px] md:text-[17px] text-gray-600 leading-relaxed">{data.implementationHighlights}</p>}
        {data.implementationImage && <img src={data.implementationImage} alt="Implementation Highlights" class="w-full rounded-xl mt-6" loading="lazy" />}
      </div>
    )}

    {allStudies.length > 0 && (
      <div class="border-t border-gray-100 pt-10 mt-8">
        <h3 class="font-clashdisplay text-[18px] md:text-[22px] font-medium text-gray-900 mb-6">More Customer Stories</h3>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          {allStudies.map(study => (
            <a href={`/case-studies/${study.slug}/`} class="block p-4 rounded-xl border border-gray-100 hover:border-primary/20 hover:shadow-sm transition-all group">
              <div class="flex flex-wrap gap-1.5 mb-2">
                <span class="text-[10px] font-grotesk bg-gray-100 text-gray-500 px-2 py-0.5 rounded-full">{study.geography}</span>
                <span class="text-[10px] font-grotesk bg-gray-100 text-gray-500 px-2 py-0.5 rounded-full">{study.industry}</span>
              </div>
              <h4 class="font-clashdisplay text-sm font-medium text-gray-800 group-hover:text-primary transition-colors line-clamp-2">{study.title}</h4>
            </a>
          ))}
        </div>
      </div>
    )}
  </div>

  <!-- Sticky Bottom CTA -->
  <div id="stickyContent2" class="sticky z-40 bottom-0 text-white bg-gradient-to-r from-secondary to-primary py-5 px-[15px] lg:px-0">
    <div class="max-w-[1200px] m-auto flex justify-between items-center">
      <div class="font-clashdisplay text-[14px] md:text-[18px] lg:text-[22px]">
        Begin your journey to <span class="font-medium">Elevate your payment experience!</span>
      </div>
      <a class="w-auto md:w-[26%] lg:w-auto" href="/contact-us/">
        <button class="before:ease relative overflow-hidden flex items-center gap-3 font-clashdisplay font-semibold text-[16px] lg:text-[20px] px-0 lg:px-6 py-[10px] rounded-0 md:rounded-full text-white bg-transparent transition-all border border-transparent lg:border-white before:absolute before:right-0 before:top-0 before:h-full before:w-6 before:translate-x-12 before:rotate-6 before:bg-white before:opacity-10 before:duration-700 hover:shadow-green-500 hover:before:-translate-x-40">
          Get Started
          <img src="/images/icons/btn_arrow.svg" alt="go" />
        </button>
      </a>
    </div>
  </div>

  <!-- Footer -->
  <div class="footer" id="footer">
    <div class="footer_group">
      <div><img src="/images/logo/pay3.svg" loading="lazy" alt="" class="mask-group-icon1" /></div>
      <div class="second">
        <div class="section_country">
          <div class="market-street-5007-container">
            <p class="nation">USA</p><p class="market-street">2261 Market Street</p><p class="market-street">#5007, San Francisco,</p><p class="market-street">CA 94114</p>
          </div>
          <div class="indiqube-crystal-73-container">
            <p class="nation">U.A.E</p><p class="market-street">Meydan Grandstand,</p><p class="market-street">6th floor, Meydan Road,</p><p class="market-street">Nad Al Sheba,</p><p class="market-street">Dubai</p>
          </div>
          <div class="indiqube-crystal-73-container">
            <p class="nation">INDIA</p><p class="market-street">Bhive,</p><p class="market-street">48, Church Street,</p><p class="market-street">Bengaluru,</p><p class="market-street">KA 560001</p>
          </div>
        </div>
        <div class="contact">
          <div class="contact-us"><p class="nation">Contact us</p><p class="market-street">hello@pay3.money</p></div>
          <div class="follow-us">
            <p class="nation">Follow Us</p>
            <div class="icon">
              <a href="https://twitter.com/pay3money" target="_blank"><img class="frame-icon" alt="" src="/images/icons/twitter-x-logo.jpg" style="height: 28px; width: 28px" /></a>
              <a href="https://www.linkedin.com/company/pay3" target="_blank"><img class="frame-icon" loading="lazy" alt="" src="/images/icons/linkedIn.png" /></a>
              <a href="https://t.me/pay3_money" target="_blank"><img class="frame-icon" loading="lazy" alt="" src="/images/icons/telegram.png" /></a>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="privacy-policy">
      <div class="link_tag">
        <a target="_blank" href="/privacy_policy.html" class="privacy" style="color: white">Privacy Policy</a>
        <a target="_blank" href="/terms_of_conditions.html" class="terms-of-service" style="color: white">Terms of service</a>
      </div>
      <div class="copyright-2023-all">Copyright ©2026 All rights reserved</div>
    </div>
  </div>

  <!-- Cookie Alert -->
  <div class="bottom" id="alertCookie">
    This site uses cookies. To find out more, read our <a class="privacy_policy_a" target="_blank" href="/privacy_policy.html">Privacy Policy</a>
    <div class="cookies-btns">
      <button class="agree-btn" onclick="acceptCookie()">I Agree</button>
      <button class="reject-btn" onclick="rejectCookie()">Reject Cookies</button>
    </div>
  </div>

  <script is:inline>
    function acceptCookie() { localStorage.setItem('isCookieAccepted', 'true'); document.getElementById('alertCookie').style.display = 'none'; var el = document.getElementById('stickyContent2'); if (el) { el.classList.remove('bottom-12'); el.classList.add('bottom-0'); } }
    function rejectCookie() { localStorage.setItem('isCookieAccepted', 'false'); document.getElementById('alertCookie').style.display = 'none'; var el = document.getElementById('stickyContent2'); if (el) { el.classList.remove('bottom-12'); el.classList.add('bottom-0'); } }
    if (localStorage.getItem('isCookieAccepted') !== null) {
      document.addEventListener('DOMContentLoaded', function() {
        document.getElementById('alertCookie').style.display = 'none';
        var el = document.getElementById('stickyContent2'); if (el) { el.classList.remove('bottom-12'); el.classList.add('bottom-0'); }
      });
    }
  </script>
</body>
</html>
