      clickedImage.style.display = 'none';

      const icons = document.querySelectorAll('.icon');
      icons.forEach(icon => {
        if (icon !== clickedImage) {
          icon.style.display = 'block';
        }
      });
      const cardTitle = document.getElementById("card-title");

      switch (imageSrc) {
        case './images/solutions/image1.webp':
          cardTitle.textContent = "Car Upgrade";
          break;
        case './images/solutions/image2.webp':
          cardTitle.textContent = "Ops Upgrade";
          break;
        case './images/solutions/image3.webp':
          cardTitle.textContent = "Car Upgrade";
          break;
        case './images/solutions/image4.webp':
          cardTitle.textContent = "Eclipse Upgrade";
          break;
        case './images/solutions/image5.webp':
          cardTitle.textContent = "Gun Upgrade";
          break;
        default:
          cardTitle.textContent = "Car Upgrade";
      }
    }
  </script>
