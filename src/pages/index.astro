  <script type="application/ld+json">
    {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
        {
            "@type": "Question",
            "name": "What services does Pay3 offer?",
            "acceptedAnswer": {
                "@type": "Answer",
                "text": "Pay3 powers the payment rails for the agentic economy. Pay3 provides agentic commerce and instant payments solutions leveraging stablecoin rails. Pay3 offers stablecoin payment infrastructure, agentic AI payments, cross-border settlement, local payment acceptance, and global treasury management. Businesses can accept, send, and settle payments across 100+ stablecoins and digital assets, 30+ blockchains, 300+ local payment methods across 100+ countries. "
            }
        },
        {
            "@type": "Question",
            "name": "What use cases does Pay3 support?",
            "acceptedAnswer": {
                "@type": "Answer",
                "text": "Pay3 supports a wide range of stablecoin and agentic payment use cases, including agentic commerce, e-commerce checkouts, cross-border payments, global treasury operations, trading and brokerage platforms, remittances, invoice payments, subscription payments, payroll and in-game transactions across global digital ecosystems."
            }
        },
        {
            "@type": "Question",
            "name": "What is agentic commerce and how does Pay3 handle autonomous payments?",
            "acceptedAnswer": {
                "@type": "Answer",
                "text": "Agentic commerce refers to AI agents autonomously discovering, deciding, and executing transactions on behalf of users or businesses. These agents can complete actions such as purchasing products, paying for APIs, managing subscriptions, or executing business workflows based on predefined conditions and user-approved mandates. Pay3 provides the payment infrastructure layer for these autonomous transactions through secure, intent-bound, and policy-controlled payments. Its platform enables AI agents to transact using stablecoin rails with programmable spending controls, global settlement capabilities, and transparent audit trails for safe and scalable agent-driven commerce."
            }
        },
        {
            "@type": "Question",
            "name": "Which digital assets, blockchains are supported?",
            "acceptedAnswer": {
                "@type": "Answer",
                "text": "Pay3 supports 100+ digital assets and stablecoins across 30+ major blockchain networks. Supported Layer-1 chains include Bitcoin, Ethereum, Solana, BNB Chain, Tron, and others, while supported Layer-2 networks include Arbitrum, Polygon, Base, Lightning Network, and more.This broad coverage enables businesses to accept, move and settle digital assets across the most widely used blockchain ecosystems through a single integration. Refer Coverage Map"
            }
        },
        {
            "@type": "Question",
            "name": "How does Pay3 handle cross-border payments?",
            "acceptedAnswer": {
                "@type": "Answer",
                "text": "Pay3 enables fast and efficient cross-border payments by leveraging stablecoin rails and multi-chain payment infrastructure.With integrated on/off-ramp capabilities and support for multiple settlement currencies, businesses can move funds globally and settle in either fiat or digital currencies, improving payment speed, transparency and operational efficiency."
            }
        },
        {
            "@type": "Question",
            "name": "What does the onboarding process look like, and what support does Pay3 offer?",
            "acceptedAnswer": {
                "@type": "Answer",
                "text": "Getting started with Pay3 is streamlined to reduce time-to-live deployment down to days. The onboarding experience consists of a swift compliance review, developer portal setup, sandbox API credentialing. Post-launch, Pay3 provides dedicated developer and operational support, including shared Slack/Telegram channels, robust technical documentation, and proactive transaction health monitoring to ensure consistent, high-uptime payment delivery. "
            }
        }
    ]
}
  </script>
