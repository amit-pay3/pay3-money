    function loadGoogleTagManager() {
      (function (w, d, s, l, i) {
        w[l] = w[l] || []; w[l].push({
          'gtm.start': new Date().getTime(), event: 'gtm.js'
        }); var f = d.getElementsByTagName(s)[0],
          j = d.createElement(s), dl = l != 'dataLayer' ? '&l=' + l : ''; j.async = true; j.src =
            'https://www.googletagmanager.com/gtm.js?id=' + i + dl; f.parentNode.insertBefore(j, f);
      })(window, document, 'script', 'dataLayer', 'GTM-NJFBMPTV');
    }

    function setCookieConsent(consent) {
      localStorage.setItem('isCookieAccepted', consent);
      hideCookieAlert();
      updateStickyContent();
      if (consent === 'true') {
        loadGoogleTagManager();
      }
    }

    function hideCookieAlert() {
      document.getElementById('alertCookie').style.display = 'none';
    }

    function updateStickyContent() {
      const stickyContentIds = ['stickyContent', 'stickyContent2'];
      stickyContentIds.forEach(id => {
        const element = document.getElementById(id);
        if (element) {
          element.classList.remove('bottom-12');
          element.classList.add('bottom-0');
        }
      });
    }

    function acceptCookie() {
      setCookieConsent('true');
    }

    function rejectCookie() {
      setCookieConsent('false');
    }

    if (localStorage.getItem('isCookieAccepted') === 'true') {
      hideCookieAlert();
      updateStickyContent();
      loadGoogleTagManager();
    }
  </script>

  <script>
    function changeTab(evt, tabName) {
      var i, tabcontent, tablinks;
      tabcontent = document.getElementsByClassName("tabcontent");
      paymentlayout = document.getElementsByClassName("payment-layout");
      for (i = 0; i < tabcontent.length; i++) {
        tabcontent[i].style.display = "none";
      }
      for (i = 0; i < paymentlayout.length; i++) {
        paymentlayout[i].style.display = "none";
      }
      tablinks = document.getElementsByClassName("tablinks");
      for (i = 0; i < tablinks.length; i++) {
        tablinks[i].className = tablinks[i].className.replace(
          " active-tab",
          ""
        );
      }
      if (tabName === "countryPayments") {
        document.getElementById("countryPayments").style.display = "block";
        document.getElementById("gamingmethod").style.display = "flex";
        evt.currentTarget.className += " active-tab";
      } else if (tabName === "payments") {
        document.getElementById("payments").style.display = "block";
        document.getElementById("gamingmethod").style.display = "flex";
        evt.currentTarget.className += " active-tab";
      } else if (tabName === "gaming") {
        document.getElementById("gaming").style.display = "block";
        document.getElementById("paymentmethod").style.display = "block";
        evt.currentTarget.className += " active-tab";
      } else if (tabName === "ecommerce") {
        document.getElementById("ecommerce").style.display = "block";
        document.getElementById("ecommercemethod").style.display = "block";
        evt.currentTarget.className += " active-tab";
      }
    }

    window.onload = function () {
      document.getElementById("countryPayments").style.display = "block";
      document.getElementById("gamingmethod").style.display = "flex";
      document.querySelector(".tablinks").classList.add("active-tab");
    };
  </script>
