          <div class="bg-gray-100 rounded-lg p-6">
            <button class="w-full text-left flex justify-between items-center" onclick="toggleFAQ(1)">
              <h3 class="text-[18px] lg:text-[22px] font-medium text-gray-800">
                What services does Pay3 offer?
              </h3>
              <div class="flex-shrink-0">
                <!-- Plus Icon -->
                <svg id="icon-plus-1" class="w-6 h-6 text-gray-500" fill="currentColor" viewBox="0 0 20 20">
